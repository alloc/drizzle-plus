{
  "include": ["src"],
  "exclude": ["src/generated", "src/extensions"],
  "compilerOptions": {
    "strict": true,
    "lib": ["esnext"],
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": true,
    "emitDeclarationOnly": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "drizzle-plus": ["./src/index.ts"],
      "drizzle-plus/pg": ["./src/functions/pg/types.ts"],
      "drizzle-plus/mysql": ["./src/functions/mysql/types.ts"],
      "drizzle-plus/sqlite": ["./src/functions/sqlite/types.ts"],
      "drizzle-plus/types": ["./src/types.ts"],
      "drizzle-plus/types/*": ["./src/types/*.ts"],
      "drizzle-plus/utils": ["./src/utils.ts"],
      "#dialect/core": ["./src/extensions/dialect/core.ts"],
      "#dialect/db": ["./src/extensions/dialect/db.ts"],
      "#dialect/query": ["./src/extensions/dialect/query.ts"],
      "drizzle-plus/#dialect": ["./src/extensions/dialect/functions.ts"]
    }
  }
}
